{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "jsdoc": false,
  "ignorePatterns": ["dist", "docs", "coverage", "node_modules", "**/*.pem"]
}
